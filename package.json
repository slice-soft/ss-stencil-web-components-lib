{
  "name": "@slice-soft/ss-stencil-web-components-lib",
  "version": "0.2.2",
  "description": "Librería de Web Components reutilizables desarrollados con StencilJS por Slice Soft",
  "author": "Slice Soft <team@slicesoft.dev>",
  "homepage": "https://github.com/slice-soft/ss-stencil-web-components-lib#readme",
  "bugs": {
    "url": "https://github.com/slice-soft/ss-stencil-web-components-lib/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "keywords": [
    "web-components",
    "stenciljs",
    "reusable-components",
    "slice-soft"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/ss-stencil-web-components-lib/ss-stencil-web-components-lib.esm.js",
  "exports": {
    ".": {
      "import": "./dist/ss-stencil-web-components-lib/ss-stencil-web-components-lib.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/types/index.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slice-soft/ss-stencil-web-components-lib.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e --coverage",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "eslint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "npm run eslint && npm run prettier"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@stencil/core": "^4.31.0",
    "@stencil/react-output-target": "^1.0.3",
    "@stencil/sass": "^3.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "eslint": "^9.27.0",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "prettier": "3.5.3",
    "puppeteer": "^25.9.0",
    "typescript-eslint": "^8.32.1"
  },
  "license": "MIT"
}
